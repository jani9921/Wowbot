+def ready(bridge):
+    bridge.world.ingest(Observation.create(addon(game_build='70575',inventory={'items':[{
+        'item_id':12345,'bag':0,'slot':1,'count':99,'x':.2,'y':.4}], 'complete':True}),9.1))
+    bridge.adapter.observations(None,bridge.world,10.)
