+             else {'kind':'WORLD_ENTITY' if skill=='INTERACT' else 'WORLD_COMBAT','expected_guid':GUID})
+    return SkillResult(SkillStatus.RUNNING,metadata={'approach_request':{**request,'stop_distance':3.5}})
