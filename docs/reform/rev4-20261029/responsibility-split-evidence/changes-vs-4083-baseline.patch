+@pytest.mark.parametrize('changes',[{'capture_epoch':'b'*32},{'game_build':70448},
+    {'process_generation':'0000000000000002'}])
+def test_wrong_capture_build_or_process_progress_does_not_establish_a_watermark(native,changes):
