+def read_root_slots(cursor):
+    """Read changed ActivePlayerData InvSlots without guessing other fields."""
+    mask=_mask(cursor,13)
+    roots=sum(1<<i for i in range(164,269))
+    if mask&roots and not mask>>163&1:
