+                and type(observed_at) in {int,float} and type(now) in {int,float}
+                and math.isfinite(observed_at) and math.isfinite(now)
+                and since<=observed_at<=row['sample_time'] and 0<=now-row['sample_time']<=WITNESS_AGE)
 
 
