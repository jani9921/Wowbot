-    def recognize_visual(self, signature: dict[str, Any] | str, *, min_seen_count: int = 3,
-                         as_of: float | None = None, max_age: float | None = None) -> list[dict[str, Any]]:
-        """Return supported identity candidates; never a confirmed identity."""
