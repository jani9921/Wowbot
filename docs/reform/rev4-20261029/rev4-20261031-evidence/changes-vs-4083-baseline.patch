+        return len(resets) > before                            # arrival/progress evidence cleared
+    leg('route:a', 1)
+    assert leg('route:a', 1) is False                          # the same leg keeps its evidence
+    assert leg('route:a', 2) is True and leg('route:b', 2) is True
