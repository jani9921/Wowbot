+    def _position_wait_status(self, state: dict, now: float) -> str | None:
+        if self._position_wait is None:
+            return None
+        from .position_acquisition import blocked, observed_height, scope
+        if scope(state) != self._position_wait['scope']:
+            return 'server_position_probe_context_changed'
+        if blocked(state):
+            return 'server_position_probe_interrupted'
+        request = self._active_request
+        budget = min(self.POSITION_ACQUISITION_SECONDS, request.timeout or self.max_reach_seconds)
+        if now-self._position_wait['started_at'] >= budget:
+            return 'server_position_probe_timeout'
+        return 'READY' if observed_height(state) is not None else 'WAITING'
+
