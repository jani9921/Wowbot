+class Raw:
+    tables = {'conditions'}
+
+    def __init__(self, rows):
+        self.values = rows
+
+    def rows(self, sql, parameters):
+        assert parameters == (79436,) and 'SourceTypeOrReferenceId=13' in sql
+        return deepcopy(self.values[:2])
+
