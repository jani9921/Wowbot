+"""Character/cast identity and arbitration over existing ability candidates."""
+from __future__ import annotations
+from dataclasses import asdict, dataclass
+import hashlib
+import json
+import math
+
+
+@dataclass(frozen=True, slots=True)
+class CharacterProfile:
+    character_guid: str | None
+    class_id: str | int | None
+    specialization_id: int | None
+    role: str
+    style: str
+    form: str | int | None
+    resource_type: str | int | None
+    bar_revision: str
+    revision: str
+    ability_ids: tuple[int, ...]
+
+    @classmethod
+    def from_state(cls, state):
+        actions = [a for a in (state.get('actionbar') or ())[:256] if isinstance(a, dict)]
+        identities = [(a.get('action'), a.get('id', a.get('spell_id')), a.get('kind')) for a in actions]
+        bar = hashlib.sha256(json.dumps([state.get('actionbar_context'), identities], sort_keys=True,
+                                       separators=(',', ':'), default=str).encode()).hexdigest()[:20]
+        ranges = [a.get('max_range') for a in actions if a.get('is_harmful') is True
+                  and type(a.get('max_range')) in {int, float} and math.isfinite(a['max_range'])]
+        style = ('MIXED' if any(r <= 5. for r in ranges) and any(r >= 20. for r in ranges) else
+                 'RANGED' if any(r >= 20. for r in ranges) else 'MELEE' if ranges else 'UNKNOWN')
+        spec = state.get('specialization_id', state.get('spec_id'))
+        spec = spec if type(spec) is int and spec > 0 else None
+        owner = (state.get('session_id'), state.get('character_guid'), state.get('class'), spec,
+                 state.get('form'), state.get('in_vehicle'), bar)
+        revision = hashlib.sha256(json.dumps(owner, sort_keys=True, default=str).encode()).hexdigest()[:20]
+        role = state.get('role') if state.get('role') in {'TANK', 'HEALER', 'DAMAGE'} else 'UNKNOWN'
+        return cls(state.get('character_guid'), state.get('class'), spec, role, style,
+                   state.get('form'), state.get('power_type'), bar, revision,
+                   tuple(a.get('id', a.get('spell_id')) for a in actions
+                         if type(a.get('id', a.get('spell_id'))) is int and a.get('kind') == 'spell'))
+
+    def diagnostic(self):
+        return asdict(self)
+
+
+@dataclass(frozen=True, slots=True)
+class CastReference:
+    caster_guid: str
+    cast_id: str
+    spell_id: int
+    started_at: float
+    ends_at: float
+    observed_at: float
+    interruptible: bool
+
+    @classmethod
+    def from_state(cls, state, now):
+        target = state.get('target') or {}
+        cast = target.get('cast')
+        if not isinstance(cast, dict) or not target.get('guid') or cast.get('caster_guid') != target['guid']:
+            return None
+        fields = ('started_at', 'ends_at', 'observed_at')
+        if (any(type(cast.get(k)) not in {int, float} or not math.isfinite(cast[k]) for k in fields)
+                or not cast['started_at'] <= cast['observed_at'] <= now < cast['ends_at']
+                or now-cast['observed_at'] > 1. or type(cast.get('interruptible')) is not bool
+                or type(cast.get('spell_id')) is not int or cast['spell_id'] <= 0
+                or not isinstance(cast.get('cast_id'), str) or not cast['cast_id']):
+            return None
+        return cls(target['guid'], cast['cast_id'], cast['spell_id'], cast['started_at'],
+                   cast['ends_at'], cast['observed_at'], cast['interruptible'])
+
+
+@dataclass(frozen=True, slots=True)
+class CombatCandidate:
+    ability_id: object
+    binding: str
+    target_guid: str | None
+    cast_id: str | None
+    bar_revision: str
+    category: str
+    deadline: float | None
+    score: float
+
+
+class CombatArbitrator:
+    """Rank existing eligible actions; no rotation, input or target ownership."""
+    def choose(self, abilities, state, now, *, expected_guid=None):
+        target = state.get('target') or {}
+        if expected_guid is not None and target.get('guid') != expected_guid:
+            return None
+        profile = CharacterProfile.from_state(state)
+        cast = CastReference.from_state(state, now) if type(now) in {int, float} else None
+        health, maximum = state.get('health'), state.get('max_health')
+        health_fraction = (health/maximum if type(health) in {int, float} and type(maximum) in {int, float}
+                           and math.isfinite(health) and math.isfinite(maximum) and maximum > 0 else None)
+        candidates = []
+        for ability in abilities:
+            if not ability.eligible or not ability.binding:
+                continue
+            tags = set(ability.definition.tags)
+            category, priority, deadline = 'ROTATION', 0, None
+            if 'INTERRUPT' in tags:
+                if cast is None or not cast.interruptible or cast.ends_at-now <= .15:
+                    continue
+                category, priority, deadline = 'INTERRUPT', 2, cast.ends_at
+            if tags & {'DEFENSIVE', 'HEAL'} and health_fraction is not None and health_fraction <= .35:
+                category, priority = 'SURVIVAL', 3 if health_fraction <= .2 else 1
+            candidates.append((priority, ability.score, CombatCandidate(
+                ability.ability_id, ability.binding,
+                target.get('guid') if ability.definition.requires_target else None,
+                cast.cast_id if category == 'INTERRUPT' else None, profile.bar_revision,
+                category, deadline, ability.score)))
+        return max(candidates, key=lambda c: (c[0], c[1]))[2] if candidates else None
+
+    @staticmethod
+    def verify_interrupt(expected: CastReference, events):
+        for event in events:
+            body = event.get('payload') or {}
+            if (event.get('event_type') == 'SPELL_INTERRUPTED' and body.get('caster_guid') == expected.caster_guid
+                    and body.get('cast_id') == expected.cast_id and body.get('spell_id') == expected.spell_id):
+                return True
+        return None  # cast disappeared/naturally ended is not an interrupt result
