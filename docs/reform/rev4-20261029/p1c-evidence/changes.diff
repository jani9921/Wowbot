+@pytest.mark.parametrize("failing", [False, True])
+def test_finished_or_unavailable_sweep_does_not_restart_at_the_lowest_floor(failing):
+    from test_pit_layer_and_pins_20261005 import _world, _moves
+
+    def sweep(*args):
